<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fab="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout android:id="@+id/main_layout_title" android:layout_width="match_parent" android:layout_height="wrap_content">
        <include layout="@layout/toolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <com.aurelhubert.ahbottomnavigation.AHBottomNavigation android:id="@+id/main_bottom_navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true"/>
    <androidx.viewpager.widget.ViewPager android:id="@+id/main_pager" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_above="@+id/main_bottom_navigation" android:layout_below="@+id/main_layout_title"/>
</RelativeLayout>
