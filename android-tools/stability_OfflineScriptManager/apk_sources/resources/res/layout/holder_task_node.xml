<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="match_parent" android:minHeight="56dp" android:paddingStart="10dp">
    <com.github.johnkil.print.PrintView android:id="@+id/icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentLeft="true" android:layout_centerHorizontal="true" android:layout_centerVertical="true" app:iconColor="#0099cc" app:iconFont="fonts/material-icon-font.ttf" app:iconSize="36dp"/>
    <TextView android:textSize="19sp" android:id="@+id/node_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="10dp" android:layout_toRightOf="@+id/icon" android:layout_centerVertical="true"/>
    <LinearLayout android:gravity="right" android:id="@+id/ll_long_click_menu" android:visibility="invisible" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_toRightOf="@+id/node_text" android:layout_centerVertical="true" android:paddingEnd="10dp">
        <com.github.johnkil.print.PrintButton android:id="@+id/btn_select_all" android:layout_width="wrap_content" android:layout_height="wrap_content" app:iconColor="#12558c" app:iconFont="fonts/material-icon-font.ttf" app:iconSize="28dp" app:iconText="@string/ic_check_box_outline"/>
        <com.github.johnkil.print.PrintButton android:id="@+id/btn_select_none" android:layout_width="wrap_content" android:layout_height="wrap_content" app:iconColor="#12558c" app:iconFont="fonts/material-icon-font.ttf" app:iconSize="28dp" app:iconText="@string/ic_check_box_outline_blank"/>
        <com.github.johnkil.print.PrintButton android:id="@+id/btn_cancel" android:layout_width="wrap_content" android:layout_height="wrap_content" app:iconColor="#12558c" app:iconFont="fonts/material-icon-font.ttf" app:iconSize="28dp" app:iconText="@string/ic_close"/>
        <com.github.johnkil.print.PrintButton android:id="@+id/btn_save" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" app:iconColor="#12558c" app:iconFont="fonts/material-icon-font.ttf" app:iconSize="28dp" app:iconText="@string/ic_save"/>
    </LinearLayout>
</RelativeLayout>
