<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:textSize="@dimen/customTitle" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="@string/name"/>
        <TextView android:textSize="@dimen/customTitle" android:textColor="#000000" android:id="@+id/tv_dialog_test_point_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:layout_marginStart="10dp"/>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp">
        <TextView android:textSize="@dimen/customTitle" android:textColor="#000000" android:id="@+id/dialog_task_edit_times_tv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="@string/times"/>
        <EditText android:textColor="#000000" android:gravity="center" android:layout_gravity="bottom" android:id="@+id/dialog_task_edit_times_et" android:layout_width="50dp" android:layout_height="wrap_content" android:layout_marginLeft="10dp" android:layout_marginTop="13dp" android:layout_marginRight="10dp" android:text="1" android:layout_marginHorizontal="10dp" android:autofillHints=" &gt; 0"/>
        <com.github.johnkil.print.PrintButton android:id="@+id/pb_times_up" android:layout_width="80dp" android:layout_height="wrap_content" app:iconColor="#12558c" app:iconFont="fonts/material-icon-font.ttf" app:iconSize="18dp" app:iconText="@string/ic_arrow_drop_up"/>
        <com.github.johnkil.print.PrintButton android:id="@+id/pb_times_down" android:layout_width="80dp" android:layout_height="wrap_content" app:iconColor="#12558c" app:iconFont="fonts/material-icon-font.ttf" app:iconSize="18dp" app:iconText="@string/ic_arrow_drop_down"/>
    </LinearLayout>
    <LinearLayout android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textStyle="bold" android:textColor="@color/red" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="@string/attention_adjustment_runtimes"/>
    </LinearLayout>
</LinearLayout>
