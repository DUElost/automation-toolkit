<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/linear_chart1" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_gravity="center" android:orientation="horizontal" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textStyle="italic|bold" android:textColor="@android:color/holo_purple" android:paddingLeft="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/on_off" android:layout_weight="1"/>
        <Switch android:id="@+id/control_onoff" android:paddingRight="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:id="@+id/linear_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3"/>
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:textStyle="italic|bold" android:textColor="@android:color/holo_purple" android:paddingLeft="25dp" android:paddingBottom="2dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/text_show_used"/>
        <ListView android:id="@+id/list_chart" android:layout_width="match_parent" android:layout_height="wrap_content" android:dividerHeight="2dp" android:layout_weight="2"/>
    </LinearLayout>
</LinearLayout>
