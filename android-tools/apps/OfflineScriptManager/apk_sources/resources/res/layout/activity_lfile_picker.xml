<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:background="@color/white" android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar android:theme="@style/ToolbarTheme" android:id="@+id/toolbar" android:background="@color/defaultColor" android:layout_width="match_parent" android:layout_height="?android:attr/actionBarSize" app:title="txt" app:titleTextColor="@color/white"/>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/layout_path" android:background="#dddddd" android:layout_width="match_parent" android:layout_height="60dp" android:layout_below="@+id/toolbar">
        <TextView android:textSize="14sp" android:ellipsize="middle" android:gravity="left" android:id="@+id/tv_path" android:padding="6dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="16dp" android:text="" android:maxLines="1" android:layout_weight="1"/>
        <TextView android:gravity="center" android:id="@+id/tv_back" android:background="@drawable/back_bg" android:padding="16dp" android:clickable="true" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="@string/UpOneLevel" android:drawableLeft="@mipmap/back"/>
    </LinearLayout>
    <Button android:textSize="18sp" android:textColor="@color/white" android:id="@+id/btn_addbook" android:background="@drawable/btn_bg" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/Selected" android:layout_alignParentBottom="true"/>
    <com.leon.lfilepickerlibrary.widget.EmptyRecyclerView android:id="@+id/recylerview" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_above="@+id/btn_addbook" android:layout_below="@+id/layout_path"/>
    <include android:id="@+id/empty_view" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@+id/layout_path" layout="@layout/emptyview"/>
</RelativeLayout>
