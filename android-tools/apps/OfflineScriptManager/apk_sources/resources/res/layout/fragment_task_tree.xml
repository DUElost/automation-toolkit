<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="horizontal" android:id="@+id/tester" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/task_creator" android:layout_weight="1" android:layout_marginStart="10dp"/>
        <EditText android:textSize="14sp" android:gravity="center" android:id="@+id/tester_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="@string/str_task_tester" android:layout_weight="2" android:layout_marginEnd="10dp"/>
    </LinearLayout>
    <RelativeLayout android:id="@+id/rl_tree_container" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@+id/tester"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="16dp" android:src="@drawable/ic_done_white_24dp" android:layout_alignParentRight="true" android:layout_alignParentBottom="true" app:backgroundTint="@color/colorPrimary"/>
</RelativeLayout>
