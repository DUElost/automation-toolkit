<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:layout_marginTop="10dp" android:layout_marginRight="6dp" app:cardCornerRadius="15dp" app:elevation="200dp">
    <RelativeLayout android:padding="6dp" android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:orientation="horizontal" android:id="@+id/title_layout" android:padding="5dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="18dp" android:textColor="@android:color/black" android:id="@+id/name" android:paddingTop="6dp" android:paddingRight="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Name:"/>
            <TextView android:textSize="18dp" android:textColor="@android:color/black" android:id="@+id/task_name" android:paddingTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textIsSelectable="true"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:id="@+id/content_layout" android:padding="5dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@+id/title_layout">
            <TextView android:textSize="18dp" android:textColor="@android:color/black" android:id="@+id/times" android:paddingTop="6dp" android:paddingRight="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Times:"/>
            <TextView android:textSize="18dp" android:textColor="@android:color/black" android:id="@+id/task_times" android:paddingTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textIsSelectable="true"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
