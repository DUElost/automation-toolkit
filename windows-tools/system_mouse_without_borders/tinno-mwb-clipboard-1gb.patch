+    /// <summary>
+    /// Tinno patch: ensure Helper process is running before outbound clipboard/file share.
+    /// Stale helper windows (FindWindow hit but process dead) are cleaned and restarted.
+    /// </summary>
+    internal static void EnsureClipboardHelperAlive()
+    {
+        if (Common.RunOnLogonDesktop || Common.RunOnScrSaverDesktop)
+        {
+            return;
+        }
+
+        try
+        {
+            Process[] processes = Process.GetProcessesByName(HelperProcessName);
+            IntPtr h = (IntPtr)NativeMethods.FindWindow(null, HELPER_FORM_TEXT);
+            bool processAlive = processes is { Length: > 0 };
+            bool windowAlive = h.ToInt32() > 0;
+
+            if (processAlive && windowAlive)
+            {
+                return;
+            }
+
+            Logger.Log($"EnsureClipboardHelperAlive: processAlive={processAlive}, windowAlive={windowAlive}. Restarting helper.");
+
+            // Stale window without process 鈥?ask it to quit if possible, then force-kill leftovers.
+            if (windowAlive && !processAlive)
+            {
+                _ = SendMessageToHelper(SharedConst.QUIT_CMD, IntPtr.Zero, IntPtr.Zero, wait: false, log: false);
+            }
+
+            if (processAlive)
+            {
+                foreach (Process p in processes)
+                {
+                    try
+                    {
+                        p.KillProcess();
+                    }
+                    catch (Exception e)
+                    {
+                        Logger.Log(e);
+                    }
+                }
+            }
+
+            RunDDHelper();
+        }
+        catch (Exception e)
+        {
+            Logger.Log(e);
+            RunDDHelper();
+        }
+    }
