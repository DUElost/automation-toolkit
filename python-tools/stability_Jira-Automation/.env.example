# JIRA Monkey 测试自动化系统环境变量配置

# 数据库配置（仅支持 SQLite，无需额外配置）
DB_TYPE=sqlite
# 数据库路径由代码根据 JIRA 系统和项目库自动生成：db/{jira_host}_{project_key}.db

# JIRA 配置
JIRA_URL=https://your-jira-instance.com
JIRA_USERNAME=your-jira-username
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROJ

# 飞书配置
LARK_APP_ID=your-lark-app-id
LARK_APP_SECRET=your-lark-app-secret
LARK_TENANT_ACCESS_TOKEN=your-tenant-access-token

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/jira_automation.log

# 系统配置
MAX_WORKERS=3
BATCH_SIZE=10
RETRY_COUNT=3
RETRY_DELAY=5
CACHE_ENABLED=true
CACHE_TTL=3600

# 判重阈值配置
ENV_THRESHOLD=0.99
CAUSE_THRESHOLD=0.90
SUMMARY_THRESHOLD=0.85