{
  "jira_export": {
    "enabled": true,
    "jql": "reporter in (dailv.tinno)",
    "max_results": 1000,
    "fields": [
      "key",
      "summary",
      "status",
      "resolution",
      "reporter",
      "assignee",
      "created",
      "updated",
      "comment",
      "fixVersions",
      "components",
      "priority",
      "description",
      "affect_project",
      "environment",
      "exp_class",
      "caused_by"
    ]
  },
  "matching": {
    "required_exact_fields": [
      "affect_project",
      "environment",
      "exp_class"
    ],
    "cause_similarity_threshold": 0.9
  },
  "status_rules": {
    "open_like_statuses": [
      "Open",
      "开放",
      "Reopened",
      "重新打开",
      "处理中"
    ],
    "resolved_statuses": [
      "已解决",
      "Verified"
    ],
    "resolved_fixed_resolutions": [
      "已修复"
    ],
    "wont_fix_resolutions": [
      "问题不修改",
      "非问题",
      "Won't Fix",
      "不解决"
    ],
    "closed_statuses": [
      "Closed",
      "已关闭",
      "已关单"
    ]
  },
  "regression": {
    "enabled": true,
    "required_regression_pass_versions": 2
  },
  "output": {
    "sqlite_path": "result/transsion_regression_cache.db",
    "excel_summary_dir": "result"
  }
}
