{
    "_description": "JIRA 决策场景备注模板配置",
    "_version": "1.0.1",
    "_updated": "2024-12-25",
    
    "templates": {
        "WONT_FIX": {
            "key": "COMMENT_WONT_FIX",
            "scenario": "Won't Fix 状态问题匹配",
            "description": "当匹配到已解决/问题不修改状态的问题时添加此备注",
            "template": "Won't fix待后续补充信息"
        },
        "REOPEN": {
            "key": "COMMENT_REOPEN",
            "scenario": "已解决问题重新打开",
            "description": "当已解决问题在新版本中复现时，重新打开并添加此备注",
            "template": "问题复现Reopen待后续补充信息"
        },
        "WAIT_NEW_VERSION": {
            "key": "COMMENT_WAIT_NEW",
            "scenario": "历史版本问题等待验证",
            "description": "当问题出现在早于修复版本的版本中时添加此备注",
            "template": "在历史版本中出现，待新版本验证结果"
        },
        "CONTINUE": {
            "key": "COMMENT_CONTINUE",
            "scenario": "问题继续出现",
            "description": "当Open/Reopened状态问题继续在新版本中出现时添加此备注",
            "template": "问题继续在新版本中出现，待后续补充信息"
        },
        "REGRESSION_PASS_1": {
            "key": "COMMENT_PASS_1",
            "scenario": "回归验证第1次PASS",
            "description": "当已解决问题在本次上传清单中未匹配到时，记录第1次回归PASS",
            "template": "已回归验证1个版本PASS"
        },
        "REGRESSION_PASS_2": {
            "key": "COMMENT_PASS_2",
            "scenario": "回归验证第2次PASS",
            "description": "当已解决问题第2次未匹配到时，记录第2次回归PASS并准备关单",
            "template": "已回归验证2个版本PASS"
        }
    },
    
    "status_keywords": {
        "closed": {
            "description": "已关闭状态关键字",
            "keywords": ["closed", "done", "已关闭", "已关单"]
        },
        "resolved": {
            "description": "已解决状态关键字",
            "keywords": ["resolved", "已解决", "verified", "已验证"]
        },
        "wont_fix": {
            "description": "Won't Fix 解决方案关键字",
            "keywords": ["won't fix", "wont fix", "不解决", "无法解决", "问题不修改", "非问题"]
        }
    },
    
    "regression_pass_filter": {
        "description": "回归验证标题过滤条件，只有标题同时包含所有关键字的问题才会进行回归PASS处理",
        "title_keywords": ["[自动化]", "[V551A]", "[MonkeyAEE]"],
        "match_mode": "all"
    },
    
    "decision_scenarios": {
        "CREATE": {
            "description": "新建问题",
            "condition": "数据库中无匹配问题",
            "action": "创建新的JIRA问题"
        },
        "UPDATE": {
            "description": "更新问题",
            "condition": "匹配到Open/Reopened状态问题",
            "action": "更新问题计数，添加CONTINUE备注",
            "comment_key": "CONTINUE"
        },
        "COMMENT": {
            "description": "添加备注",
            "condition": "匹配到已解决/问题不修改状态问题",
            "action": "仅添加备注，不改变状态",
            "comment_key": "WONT_FIX"
        },
        "REOPEN": {
            "description": "重新打开",
            "condition": "匹配到已解决/完成状态问题，且版本晚于修复版本",
            "action": "重新打开问题，添加REOPEN备注",
            "comment_key": "REOPEN"
        },
        "IGNORE": {
            "description": "忽略",
            "condition": "匹配到已关闭状态问题，且解决结果为问题不修复",
            "action": "不做任何操作"
        },
        "RECREATE": {
            "description": "重新提单",
            "condition": "匹配到已关闭状态问题，但解决结果不是问题不修复",
            "action": "创建新的JIRA问题"
        },
        "REGRESSION_PASS": {
            "description": "回归PASS",
            "condition": "已解决问题在本次上传清单中未匹配到，且标题包含指定关键字",
            "action": "记录回归PASS，第2次PASS后关单",
            "comment_keys": ["REGRESSION_PASS_1", "REGRESSION_PASS_2"],
            "filter": "regression_pass_filter"
        }
    }
}
