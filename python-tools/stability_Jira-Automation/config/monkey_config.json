  "automation_settings": {
    "similarity_threshold": 0.85,
    "require_confirmation": true,
    "batch_size": 10,
    "api_delay_seconds": 1,
    "max_search_results": 20,
    "fingerprint_elements": [
      "package_name",
      "exception_class",
      "exception_type",
      "crash_location",
      "test_environment"
    ]
  },
  "decision_rules": {
    "similarity_thresholds": {
      "high_confidence": 0.95,
      "medium_confidence": 0.85,
      "low_confidence": 0.70
    },
    "status_actions": {
      "open_statuses": ["open", "in progress", "reopened", "to do"],
      "closed_statuses": ["closed", "resolved", "done", "fixed"],
      "unknown_statuses": ["pending", "waiting", "blocked"]
    },
    "priority_mapping": {
      "critical": "Highest",
      "blocker": "Highest",
      "major": "High",
      "minor": "Medium",
      "trivial": "Low"
    }
  },
  "text_processing": {
    "fingerprint_cleaning": {
      "remove_patterns": [
        "\\d+\\.\\d+\\.\\d+",
        "v\\d+\\.\\d+",
        "\\d{4}-\\d{2}-\\d{2}",
        "\\d{2}:\\d{2}:\\d{2}",
        "0x[0-9a-fA-F]+",
        ":\\d+"
      ]
    },
    "search_keywords": {
      "critical_keywords": ["崩溃", "闪退", "死机", "无法启动", "数据丢失", "crash", "exception"],
      "major_keywords": ["卡顿", "缓慢", "异常", "错误", "失败", "slow", "error", "fail"],
      "minor_keywords": ["建议", "优化", "改进", "体验", "suggestion", "improvement"]
    }
  },
  "jira_field_mapping": {
    "tinno": {
      "custom_fields": {
        "bug_severity": "customfield_10120",
        "key_information": "customfield_10500"
      },
      "components": {
        "android": "Android客户端",
        "ios": "iOS客户端",
        "backend": "后端服务",
        "web": "Web前端"
      }
    },
    "transsion": {
      "custom_fields": {
        "bug_severity": "customfield_12500",
        "test_environment": "customfield_10201",
        "package_name": "customfield_10202",
        "exception_info": "customfield_10203"
      },
      "components": {
        "android": "Android",
        "system": "System",
        "app": "Application"
      }
    }
  },
  "logging": {
    "level": "INFO",
    "file": "monkey_automation.log",
    "max_size_mb": 10,
    "backup_count": 5,
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  },
  "notification": {
    "enabled": false,
    "webhook_url": "",
    "mention_users": [],
    "send_summary": true
  }
}
